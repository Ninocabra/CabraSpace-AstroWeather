# Datos: NUNCA al repo (van a disco/objeto, no a git)...
data/*
*.parquet

# ...CON UNA EXCEPCION, y solo una. Los 51 miembros del EPS son lo unico del
# archivo que NO se puede volver a descargar: aguas arriba se conservan 4-5
# dias. Mientras el scheduler dependa de que un PC concreto este encendido, cada
# noche apagada es una noche perdida para siempre -- el 28-08-2026 ya se perdio
# la pasada de las 06:10. Son ~4 kB por pasada, dos al dia: 3 MB al anio.
# El canonico NO viaja: se re-deriva del raw, que es la evidencia.
!data/raw/
data/raw/*
!data/raw/site=nerpio/
data/raw/site=nerpio/*
!data/raw/site=nerpio/source=openmeteo_ensemble/
# Y el rescate por `past_days` (14-11-2026, tras las pasadas perdidas del 11 al
# 14): es el unico raw que queda de esas horas. Va aparte, con su propia fuente,
# porque NO es una pasada: ver `workers/backfill_ensemble_past.py`.
!data/raw/site=nerpio/source=openmeteo_ensemble_past_days/
*.nc
*.grib
*.grib2
*.zip

# Capturas de la allsky para medir k: ~40 MB por noche de JPEG que se pueden
# volver a mirar pero no volver a bajar. Viven en disco, no en git.
capturas/

# Secretos
.env
.cdsapirc
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Sistema
.DS_Store
Thumbs.db

